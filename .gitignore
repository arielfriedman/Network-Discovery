# Credentials - the vault must never be committed, encrypted or not.
discovery/config/vault.gpg
discovery/config/vault*
*.gpg
*.asc

# Scan results: these describe a real network. Keep them local.
discovery/reports/*
!discovery/reports/.gitkeep
panel/reports/*
!panel/reports/.gitkeep
panel/backups/*
!panel/backups/.gitkeep

# Local settings (database password, overrides)
discovery/config/settings.local.conf
discovery/config/known_hosts
discovery/config/ieee-oui.csv
panel/settings.local.json
.env

# Python
__pycache__/
*.pyc
.venv/

# Editor / OS noise
*.swp
*~
.DS_Store
